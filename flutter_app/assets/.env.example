# Copy to .env and set your backend URL (same whether backend runs on host or in Docker)
# Same machine: http://localhost:8000  |  Android emulator: http://10.0.2.2:8000
# App on phone / other device: http://YOUR_MACHINE_IP:8000 (e.g. http://192.168.1.32:8000)
API_BASE_URL=http://localhost:8000

# Supabase project URL – required for journal entry images in history/list. Same as backend .env SUPABASE_URL.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
