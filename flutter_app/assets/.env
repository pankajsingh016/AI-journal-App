# Backend API base URL (no trailing slash)
# Same machine: use http://localhost:8000
# Backend on another device (e.g. your laptop): use your laptop's IP, e.g. http://192.168.1.100:8000
# API_BASE_URL=http://192.168.1.32:8000

API_BASE_URL=http://10.53.220.117:8000
# Supabase project URL – set this so journal entry images load.
# Use the same value as SUPABASE_URL in backend .env (Supabase dashboard → Settings → API → Project URL).
# If images don't show, uncomment and set to your project URL, e.g. https://abcdefgh.supabase.co
# SUPABASE_URL=https://xxxxx.supabase.co
